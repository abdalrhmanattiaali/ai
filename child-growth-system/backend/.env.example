# ========================================
# 🌟 رفيق النمو - Child Growth System
# ========================================
# إعدادات جاهزة للاستخدام المباشر!
#
# 📝 بيانات الدخول الافتراضية:
#    Username: admin
#    Password: 123456
#
# 🚀 للبدء:
#    1. انسخ هذا الملف: cp .env.example .env
#    2. تأكد من تشغيل MongoDB: sudo systemctl start mongod
#    3. npm install
#    4. npm run setup  (لإنشاء المستخدم الافتراضي)
#    5. npm run dev
# ========================================

# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database - MongoDB محلي
MONGODB_URI=mongodb://localhost:27017/child-growth-system

# Redis (اختياري)
REDIS_URL=redis://localhost:6379

# JWT - مفتاح افتراضي جاهز للاستخدام
JWT_SECRET=rafeeq-growth-default-secret-key-2024-ready-to-use
JWT_EXPIRE=30d

# OpenAI - اختياري (النظام يعمل بدونه)
# احصل على مفتاح من: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (اختياري)
ANTHROPIC_API_KEY=

# Weather API (اختياري - من openweathermap.org)
OPENWEATHER_API_KEY=

# Google APIs (اختياري)
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=

# Email (اختياري)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# WhatsApp
WHATSAPP_SESSION_PATH=./whatsapp-sessions
