# AI Configuration (اختر واحد فقط)
# للاستخدام مع OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# أو للاستخدام مع Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# اختر نوع AI: openai أو anthropic
AI_PROVIDER=openai

# Weather API (من OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_CITY=Cairo,EG

# Server Configuration
PORT=3000

# WhatsApp Configuration
# رقم الواتساب للأب (بدون +)
FATHER_PHONE=201234567890
# رقم الواتساب للأم (بدون +)
MOTHER_PHONE=201234567891

# Timezone
TIMEZONE=Africa/Cairo
